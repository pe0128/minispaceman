[configuration]
entry_symbol = "minispaceman_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://native/bin/minispaceman.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/minispaceman.windows.template_release.x86_64.dll"
macos.debug = "res://native/bin/minispaceman.macos.template_debug.universal.dylib"
macos.release = "res://native/bin/minispaceman.macos.template_release.universal.dylib"
