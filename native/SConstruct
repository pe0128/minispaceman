#!/usr/bin/env python
from pathlib import Path
import sys

ARGUMENTS.setdefault("compiledb_file", "../compile_commands.json")
env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src"])
env["SHLIBPREFIX"] = ""
if env["platform"] == "windows":
    env.Append(LIBS=["user32", "dwmapi", "advapi32"])
elif env["platform"] == "macos":
    # godot-cpp supplies a custom link command; FRAMEWORKS alone is not
    # expanded by that command. Pass the Apple frameworks explicitly.
    env.Append(LINKFLAGS=["-framework", "CoreGraphics", "-framework", "CoreFoundation", "-framework", "Foundation", "-framework", "ServiceManagement", "-framework", "AppKit"])
    env.Append(CCFLAGS=["-mmacosx-version-min=13.0"])
else:
    Exit("Only Windows and macOS are supported")
suffix = env["suffix"]
sources = Glob("src/*.cpp")
if env["platform"] == "macos":
    sources += Glob("src/*.mm")
library = env.SharedLibrary("bin/minispaceman" + suffix + env["SHLIBSUFFIX"], sources)
sys.path.insert(0, Dir("../tools").abspath)
from compilation_database import configure
configure(env)
Default(library)
